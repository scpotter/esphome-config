# secrets.yaml.example -- fictional values, safe to commit.
#
# The real secrets.yaml is gitignored. On the VM 151 host it is rendered from
# Infisical by refresh-secrets.sh (real values). In the dev container, copy this
# file to secrets.yaml for `esphome config` / `esphome compile` checks -- the
# resulting binary is not flashable with real credentials; real builds and OTA
# go through the esphome-builder stack.
#
# Where each key lives in Infisical (this operator):
#   wifi_ssid, wifi_password        -> core-infra           /wifi/potter_net/
#   API_key, ESPadmin_password,     -> smarthome-selfhosted  /esphome/
#   ota_password
#   <device>_ip (per-device)        -> dahome_private_config host_config.env
#                                      (ESPHOME_BUILDER_DEV_<NAME>_IP)

wifi_ssid: "ExampleSSID"
wifi_password: "example-wifi-passphrase"
API_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
ESPadmin_password: "example-fallback-ap-password"
ota_password: "example-ota-password"

# per-device fallback addresses (use_address in each device's wifi: block)
humidor_ip: "10.0.0.11"
desk_ip: "10.0.0.12"
ro_ip: "10.0.0.13"
fireplace_ip: "10.0.0.14"
proto_ip: "10.0.0.15"
