# example.env -- copy to host_config.env (gitignored, never committed).
#
# This repo's public interface: launch.sh / refresh-secrets.sh source
# ./host_config.env for these bare names, and pull true secrets from Infisical
# separately. How host_config.env gets populated is up to you:
#
#  - This operator: generated by dahome_private_config/estate/hosts/stack-launch.sh
#    (strips the ESPHOME_BUILDER_ prefix, passes the Infisical project IDs).
#  - A forker: fill it in by hand from this file.
#
# The bootstrap credential (the Infisical identity's Client ID/Secret) goes in
# ~/.secrets/infisical.env on the host, NOT here and NOT git:
#   LAUNCH_ESPHOME_CLIENT_ID=...
#   LAUNCH_ESPHOME_CLIENT_SECRET=...

# Infisical coordinates
INFISICAL_API_URL=https://your-infisical-instance
CORE_INFRA_PROJECT_ID=your-core-infra-project-id
SMARTHOME_SELFHOSTED_PROJECT_ID=your-smarthome-selfhosted-project-id

# Hostnames/IPs allowed as the Host header on the dashboard (6052) and the
# remote-build peer link (6055) -- the ESPHome trusted-domains check. Include
# this build host and the paired HA instance, by name AND by IP (the dashboard
# rejects an IP Host header that isn't on this list).
TRUSTED_DOMAINS=builder.example.com,homeassistant.example.com,10.0.0.10,10.0.0.11

# Per-device fallback IP addresses -- DEV_<NAME>_IP renders as <name>_ip: in
# secrets.yaml, consumed by `use_address:` in each device's wifi: block.
DEV_HUMIDOR_IP=10.0.0.11
DEV_DESK_IP=10.0.0.12
DEV_RO_IP=10.0.0.13
DEV_FIREPLACE_IP=10.0.0.14
DEV_PROTO_IP=10.0.0.15
