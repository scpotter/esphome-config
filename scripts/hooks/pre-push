#!/usr/bin/env bash
# Slice 7a Plan C -- pre-push gate for esphome-config.
#
# yamllint, scoped to the files this push actually changes (not the whole
# tree -- pre-existing content is already live and would otherwise block every
# future push regardless of relevance), plus a !secret coverage check on the
# pushed commit (check_secret_coverage, below).
#
# esphome's own `esphome config` validation is NOT wired here: it needs a
# validated way to run it against a checkout without real device secrets.
set -euo pipefail

# !secret coverage: every uncommented `!secret <name>` in the pushed commit's
# YAML must have a top-level key in that commit's secrets.yaml.example. Reads
# the commit (git show), not the working tree, so an uncommitted edit can
# neither hide nor cause a failure. A reference inside a YAML comment is not a
# requirement. This is the one part of the provision-declare-reference workflow
# a workspace checkout can see; it cannot tell whether the real value exists.
check_secret_coverage() {
    local sha="$1" q refs keys missing m
    q="['\"]"
    refs="$(
        git ls-tree -r -z --name-only "$sha" | grep -zE '\.ya?ml$' |
            while IFS= read -r -d '' f; do git show "${sha}:${f}"; done |
            sed -E 's/^[[:space:]]*#.*$//; s/[[:space:]]#.*$//' |
            grep -oE "!secret[[:space:]]+${q}?[A-Za-z0-9_]+" |
            sed -E "s/^!secret[[:space:]]+${q}?//" | sort -u || true
    )"
    keys="$(git show "${sha}:secrets.yaml.example" 2>/dev/null |
        grep -oE '^[A-Za-z0-9_]+:' | tr -d ':' | sort -u || true)"
    missing="$(comm -23 <(printf '%s\n' "$refs" | grep -v '^$' || true) \
        <(printf '%s\n' "$keys" | grep -v '^$' || true))"
    if [ -n "$missing" ]; then
        echo "pre-push: !secret coverage failed for ${sha:0:9} -- these uncommented" >&2
        echo "  !secret references have no key in secrets.yaml.example:" >&2
        while IFS= read -r m; do printf '    %s\n' "$m" >&2; done <<<"$missing"
        echo "  Provision the real value first, then declare a fictional entry." >&2
        return 1
    fi
    return 0
}

# Source resolution, split by source type: every uncommented top-level key
# in the pushed commit's secrets.yaml.example is classified by
# check-source-resolution.py (shared across all three pre-push hooks --
# slice 7a Plan F Stage G). A "host" row is checked in full (row present,
# its host_config.env var present and non-empty) and BLOCKS if broken --
# fully knowable locally, no external dependency. An "infisical" row is
# checked only for its own well-formedness -- WARNS if broken, since this
# container's identity can't tell "the secret doesn't exist" from "my
# access is the problem." A row-less key also only warns (the normal
# in-progress state right after adding a fictional .example entry). The
# actual Infisical value is never resolved here -- that stays a render-time
# (Validate) and human concern (SPEC section 5).
check_source_resolution() {
    local sha="$1" range="$2" repo_root estate sources hostenv checker out rc
    git diff --name-only "$range" 2>/dev/null | grep -qx 'secrets.yaml.example' || return 0

    repo_root="$(git rev-parse --show-toplevel)"
    estate="$(cd "${repo_root}/../estate" && pwd)"
    sources="${estate}/hosts/yaml-render-sources/esphome.json"
    hostenv="${estate}/host_config.env"
    checker="${estate}/hosts/check-source-resolution.py"
    if [ ! -f "$sources" ]; then
        echo "pre-push: WARNING -- source-mapping file not found: $sources" >&2
        return 0
    fi

    rc=0
    out="$(git show "${sha}:secrets.yaml.example" 2>/dev/null |
        uv run --no-project --with pyyaml python3 "$checker" "$sources" "$hostenv" 2>&1)" || rc=$?

    if [ "$rc" -ne 0 ]; then
        echo "pre-push: WARNING -- source-resolution check itself failed to run (${out:-no output}); not blocking on a check that couldn't run." >&2
        return 0
    fi
    if [ -n "$out" ]; then
        echo "$out" | sed -E 's/^BLOCK: /pre-push: /; s/^WARN: /pre-push: WARNING -- /' >&2
        echo "$out" | grep -q '^BLOCK:' && return 1
    fi
    return 0
}

empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
zero_sha=0000000000000000000000000000000000000000
had_error=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero_sha" ] && continue  # deleting a branch, nothing to check

    if [ "$remote_sha" = "$zero_sha" ]; then
        # New branch/ref on the remote (e.g. a fresh feature branch) -- diff
        # from where it actually diverged from main, not from nothing. The
        # empty-tree fallback would otherwise flag every pre-existing file in
        # the repo as "changed" on a brand-new branch's first push.
        base="$(git merge-base main "$local_sha" 2>/dev/null || echo "$empty_tree")"
        range="$base..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    check_secret_coverage "$local_sha" || had_error=1
    check_source_resolution "$local_sha" "$range" || had_error=1

    changed=()
    while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] && changed+=("$f")
    done < <(git diff --name-only "$range" -- '*.yaml' '*.yml' 2>/dev/null || true)

    [ "${#changed[@]}" -eq 0 ] && continue

    echo "pre-push: yamllint on ${#changed[@]} changed file(s)..."
    if ! uvx yamllint -c .yamllint "${changed[@]}"; then
        had_error=1
    fi
done

if [ "$had_error" -ne 0 ]; then
    echo "pre-push: checks failed -- push aborted. Fix the above and retry." >&2
    exit 1
fi

exit 0
