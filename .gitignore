# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml
/host_config.env
/esphome-builder/.env
/trash**

# LLM Generated
../*-secrets/
.vscode/
*.log
*.db
secrets.yaml

# HAOS-side push-capable deploy key (slice 7a Plan C step 6) -- lives inside
# the git-tracked tree itself so it persists across HA Core container
# recreation (SPEC §4), so it must be excluded here explicitly.
.ssh/